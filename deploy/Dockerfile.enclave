# syntax=docker/dockerfile:1
#
# RNG Engine enclave image. Multi-stage:
#   1. Maven      -> shaded rng-service.jar (vanilla Maven Central)
#   2. GraalVM    -> static-ish native binary, metadata from the tracing agent
#   3. debian-slim runtime -> the rootfs nitro-cli turns into the EIF
#
# Build context = repo root:  docker build -f deploy/Dockerfile.enclave -t rng-engine:latest .

# ---- Stage 1: build the uber jar --------------------------------------------
FROM maven:3.9-eclipse-temurin-24 AS jar
WORKDIR /src
COPY . .
# -am builds the modules rng-service depends on (proto, common-crypto)
RUN mvn -q -B -pl rng-service -am -DskipTests package

# ---- Stage 2: GraalVM native image ------------------------------------------
FROM ghcr.io/graalvm/native-image-community:24 AS native
WORKDIR /build
COPY --from=jar /src/rng-service/target/rng-service.jar app.jar

# Record reachability metadata (protobuf reflection, BouncyCastle, FFM linkage).
RUN java -agentlib:native-image-agent=config-output-dir=/build/cfg \
         --enable-native-access=ALL-UNNAMED \
         -cp app.jar com.mario.rng.NativeWarmup || true

# Compile to a native binary.
RUN native-image \
      --no-fallback \
      --enable-native-access=ALL-UNNAMED \
      -H:ConfigurationFileDirectories=/build/cfg \
      --initialize-at-run-time=org.bouncycastle \
      -jar app.jar rng-engine

# ---- Stage 3: enclave runtime rootfs ----------------------------------------
FROM debian:12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=native /build/rng-engine /rng-engine
ENV RNG_VSOCK_PORT=5005
ENTRYPOINT ["/rng-engine"]
